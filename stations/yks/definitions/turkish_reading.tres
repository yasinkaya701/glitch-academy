[resource]
script = ExtResource("1")
id = &"turkish_reading"
grade = 12
routes = PackedStringArray("tyt")
description = "Paragraf kanıtlarından ana düşünceyi çıkar."
scene = ExtResource("2")
title = "Yanlış Yorum"
subject = "Türkçe"
field_tags = PackedStringArray("sayisal", "ea", "sozel")
curriculum = "TYT Türkçe · Paragrafta çıkarım ve değişen yargı"
source_url = "https://ogmmateryal.eba.gov.tr/kitap/mebi-konu-ozetleri/tyt-turkce/tyt-turkce.pdf"
source_note = "OGM Materyal · TYT Türkçe konu özeti, Paragrafta Ana Düşünce"
learning_target = "Yeni kanıt geldiğinde paragraftaki ilk yorumu hangi çıkarımın değiştirdiğini belirle."
instruction = "İkinci cümlenin ilk yorumu nasıl düzelttiğini seç."
prompt = "Bir okulun sessiz çalışma salonu öğleden sonra boş kalıyordu. İlk yorum, öğrencilerin sessiz ortamı istemediğiydi; ancak akşam ölçümü, öğrencilerin çoğunun dersleri bitince geldiğini gösterdi. Hangi yorum yeni kanıtla değişmelidir?"
visual_theme = &"reading"
mode = "choice"
options = PackedStringArray("Boş salon, öğrencilerin sessizliği istemediğini kanıtlar.", "Yoğunluk ders çıkış saatine bağlı olabilir; sessizlik isteği hakkında kesin kanıt yoktur.", "Akşam ölçümü, salonun gün boyu kapalı olduğunu gösterir.", "Öğrenciler yalnızca kalabalık salonlarda çalışabilir.")
correct_option = "Yoğunluk ders çıkış saatine bağlı olabilir; sessizlik isteği hakkında kesin kanıt yoktur."
feedback_wrong = "İlk gözlem yalnızca öğleden sonrayı kapsıyor; akşam ölçümü hangi değişkeni ekliyor?"
feedback_success = "Doğru. Salonun öğleden sonra boş olması sessizlik isteğini açıklamaz; yeni veri, geliş saatinin ders çıkışına bağlı olduğunu gösterir."
