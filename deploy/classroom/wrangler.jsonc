{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "yanlis-dunya-sinif-sohbetleri",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "vars": { "LUNA_PAUSED": "1" },
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "20261120", "simple": { "limit": 18, "period": 60 } }
  ]
}
