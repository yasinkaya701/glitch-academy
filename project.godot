; Godot Engine project configuration.
config_version=5

[application]

config/name="Yanlış Dünya"
run/main_scene="res://scenes/control_center.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

UITheme="*res://scripts/ui_theme.gd"
Sfx="*res://scripts/sfx.gd"
Campaign="*res://scripts/campaign_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

textures/default_filters/anisotropic_filtering_level=3

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.067, 0.11, 1)
